SECRET_KEY=change-me
DATABASE_URL=sqlite:///smart_water.db

# SMTP / Email (Brevo) - copy from .env / Brevo dashboard
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-brevo-account-login@example.com
SMTP_PASS=xsmtpsib-your-smtp-key
# MAIL_FROM must be a sender VERIFIED in the Brevo dashboard (Account > Senders).
# Use b3e2a0001@smtp-brevo.com to test, or a verified sender like no-reply@yourdomain.com.
MAIL_FROM=b3e2a0001@smtp-brevo.com
# MAIL_DEBUG=1

# Brevo HTTP API key (starts with "xkeysib-"). Used for sending instead of
# SMTP because Render's free tier blocks outbound SMTP.
BREVO_API_KEY=xkeysib-your-api-key